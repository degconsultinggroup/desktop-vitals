# Copy to .env if you want overrides. The board reads the process environment.
# Values here are empty on purpose. Do not put secrets in this file.

# Folder for status.html, state, and renders. Default: runtime next to the script.
DEG_RUNTIME_DIR=

# Desk runners and edge paper. Default: the current user's Documents folders.
DEG_DESK_ROOT=
DEG_EDGE_PAPER=

# PawnIO CPU sensor JSON. Default: ProgramData/DEG/cpu-sensor/out/last.json
DEG_SENSOR_FILE=

# Wallpaper size as WIDTHxHEIGHT. Default: 3440x1440.
DEG_RENDER_SIZE=

# Set to 0 to skip the wallpaper blur. Default: 1.
DEG_RENDER_BLUR=

# Windows profile used to find Documents. Usually set by the sign-in session.
USERPROFILE=
HOME=

# Machine data root. On Windows the usual value is C:\ProgramData.
PROGRAMDATA=

# Name drawn on the board. Default: COMPUTERNAME, or "This PC".
COMPUTERNAME=

# register-desktop-status.ps1 uses these when -UserId is omitted.
USERDOMAIN=
USERNAME=
